package com.physics.test

import godot.api.*
import godot.core.NodePath
import kotlin.reflect.KProperty

object GDTree {
    val Main = MainScene("/root/Main")
}

open class MainScene(private val path: String) : NodeRef<Control>(path, "Control") {
    val TestsMenu = NodeRef<MenuButton>("$path/TestsMenu", "MenuButton")
    val LabelControls = NodeRef<Label>("$path/LabelControls", "Label")
    val LabelFPS = NodeRef<Label>("$path/LabelFPS", "Label")
    val LabelEngine = NodeRef<Label>("$path/LabelEngine", "Label")
    val LabelVersion = NodeRef<Label>("$path/LabelVersion", "Label")
    val LabelTest = NodeRef<Label>("$path/LabelTest", "Label")
    val LabelPause = NodeRef<Label>("$path/LabelPause", "Label")
    val PanelLog = PanelLogTree()

    inner class PanelLogTree : NodeRef<Panel>("$path/PanelLog", "Panel") {
        val ButtonClear = NodeRef<Button>("$path/PanelLog/ButtonClear", "Button")
        val CheckBoxScroll = NodeRef<CheckButton>("$path/PanelLog/CheckBoxScroll", "CheckButton")
        val ScrollLog = ScrollLogTree()

        inner class ScrollLogTree : NodeRef<ScrollContainer>("$path/PanelLog/ScrollLog", "ScrollContainer") {
            val VBoxLog = VBoxLogTree()

            inner class VBoxLogTree : NodeRef<VBoxContainer>("$path/PanelLog/ScrollLog/VBoxLog", "VBoxContainer") {
                val LabelLog = NodeRef<Label>("$path/PanelLog/ScrollLog/VBoxLog/LabelLog", "Label")
            }
        }
    }
}

open class NodeRef<T : Node>(
    private val path: String,
    private val type: String,
) {
    operator fun getValue(thisRef: Node, property: KProperty<*>): T {
        val node = thisRef.getNode(NodePath(path)) ?: throw NodeNotFoundException(path)
        @Suppress("UNCHECKED_CAST")
        (node as? T) ?: throw NodeInvalidTypeException(type)
        return node
    }
}

class NodeNotFoundException(expectedPath: String) : Exception("Node not found under given path $expectedPath")

class NodeInvalidTypeException(expectedType: String?) : Exception("Node is not an instance of $expectedType")
