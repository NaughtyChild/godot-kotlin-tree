package com.example.game

import godot.api.*
import godot.core.NodePath
import kotlin.reflect.KProperty

object GDTree {
    val HUD = HUDScene("/root/HUD")
    val Main = MainScene("/root/Main")
    val Mob = MobScene("/root/Mob")
    val Player = PlayerScene("/root/Player")
}

open class HUDScene(private val path: String) : NodeRef<CanvasLayer>(path, "CanvasLayer") {
    val ScoreLabel = NodeRef<Label>("$path/ScoreLabel", "Label")
    val MessageLabel = NodeRef<Label>("$path/MessageLabel", "Label")
    val StartButton = NodeRef<Button>("$path/StartButton", "Button")
    val MessageTimer = NodeRef<Timer>("$path/MessageTimer", "Timer")
}

open class MainScene(private val path: String) : NodeRef<Node>(path, "Node") {
    val ColorRect = NodeRef<ColorRect>("$path/ColorRect", "ColorRect")
    val Player = PlayerScene("$path/Player")
    val MobTimer = NodeRef<Timer>("$path/MobTimer", "Timer")
    val ScoreTimer = NodeRef<Timer>("$path/ScoreTimer", "Timer")
    val StartTimer = NodeRef<Timer>("$path/StartTimer", "Timer")
    val StartPosition = NodeRef<Marker2D>("$path/StartPosition", "Marker2D")
    val MobPath = MobPathTree()
    val HUD = HUDScene("$path/HUD")
    val Music = NodeRef<AudioStreamPlayer>("$path/Music", "AudioStreamPlayer")
    val DeathSound = NodeRef<AudioStreamPlayer>("$path/DeathSound", "AudioStreamPlayer")

    inner class MobPathTree : NodeRef<Path2D>("$path/MobPath", "Path2D") {
        val MobSpawnLocation = NodeRef<PathFollow2D>("$path/MobPath/MobSpawnLocation", "PathFollow2D")
    }
}

open class MobScene(private val path: String) : NodeRef<RigidBody2D>(path, "RigidBody2D") {
    val AnimatedSprite2D = NodeRef<AnimatedSprite2D>("$path/AnimatedSprite2D", "AnimatedSprite2D")
    val CollisionShape2D = NodeRef<CollisionShape2D>("$path/CollisionShape2D", "CollisionShape2D")
    val VisibleOnScreenNotifier2D = NodeRef<VisibleOnScreenNotifier2D>("$path/VisibleOnScreenNotifier2D", "VisibleOnScreenNotifier2D")
}

open class PlayerScene(private val path: String) : NodeRef<Area2D>(path, "Area2D") {
    val AnimatedSprite2D = NodeRef<AnimatedSprite2D>("$path/AnimatedSprite2D", "AnimatedSprite2D")
    val CollisionShape2D = NodeRef<CollisionShape2D>("$path/CollisionShape2D", "CollisionShape2D")
    val Trail = NodeRef<GPUParticles2D>("$path/Trail", "GPUParticles2D")
}

open class NodeRef<T : Node>(
    private val path: String,
    private val type: String,
) {
    operator fun getValue(thisRef: Node, property: KProperty<*>): T {
        val node = thisRef.getNode(NodePath(path)) ?: throw NodeNotFoundException(path)
        @Suppress("UNCHECKED_CAST")
        (node as? T) ?: throw NodeInvalidTypeException(type)
        return node
    }
}

class NodeNotFoundException(expectedPath: String) : Exception("Node not found under given path $expectedPath")

class NodeInvalidTypeException(expectedType: String?) : Exception("Node is not an instance of $expectedType")
