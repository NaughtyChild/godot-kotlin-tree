package com.waypoints.test

import godot.api.*
import godot.core.NodePath
import kotlin.reflect.KProperty

object GDTree {
    val Main = MainScene("/root/Main")
    val Waypoint = WaypointScene("/root/Waypoint")
}

open class MainScene(private val path: String) : NodeRef<Node3D>(path, "Node3D") {
    val BlueCube = BlueCubeTree()
    val GreenCube = GreenCubeTree()
    val YellowCube = YellowCubeTree()
    val RedCube = RedCubeTree()
    val Camera3D = NodeRef<Camera3D>("$path/Camera3D", "Camera3D")
    val Label = NodeRef<Label>("$path/Label", "Label")
    val Ground = NodeRef<MeshInstance3D>("$path/Ground", "MeshInstance3D")
    val WhiteCube = NodeRef<MeshInstance3D>("$path/WhiteCube", "MeshInstance3D")
    val Environment = EnvironmentTree()

    inner class BlueCubeTree : NodeRef<MeshInstance3D>("$path/BlueCube", "MeshInstance3D") {
        val WaypointAnchor = WaypointAnchorTree()

        inner class WaypointAnchorTree : NodeRef<Marker3D>("$path/BlueCube/WaypointAnchor", "Marker3D") {
            val Waypoint = WaypointScene("$path/BlueCube/WaypointAnchor/Waypoint")
        }
    }

    inner class GreenCubeTree : NodeRef<MeshInstance3D>("$path/GreenCube", "MeshInstance3D") {
        val WaypointAnchor = WaypointAnchorTree()

        inner class WaypointAnchorTree : NodeRef<Marker3D>("$path/GreenCube/WaypointAnchor", "Marker3D") {
            val Waypoint = WaypointScene("$path/GreenCube/WaypointAnchor/Waypoint")
        }
    }

    inner class YellowCubeTree : NodeRef<MeshInstance3D>("$path/YellowCube", "MeshInstance3D") {
        val WaypointAnchor = WaypointAnchorTree()

        inner class WaypointAnchorTree : NodeRef<Marker3D>("$path/YellowCube/WaypointAnchor", "Marker3D") {
            val Waypoint = WaypointScene("$path/YellowCube/WaypointAnchor/Waypoint")
        }
    }

    inner class RedCubeTree : NodeRef<MeshInstance3D>("$path/RedCube", "MeshInstance3D") {
        val WaypointAnchor = WaypointAnchorTree()

        inner class WaypointAnchorTree : NodeRef<Marker3D>("$path/RedCube/WaypointAnchor", "Marker3D") {
            val Waypoint = WaypointScene("$path/RedCube/WaypointAnchor/Waypoint")
        }
    }

    inner class EnvironmentTree : NodeRef<WorldEnvironment>("$path/Environment", "WorldEnvironment") {
        val Sun = NodeRef<DirectionalLight3D>("$path/Environment/Sun", "DirectionalLight3D")
    }
}

open class WaypointScene(private val path: String) : NodeRef<Control>(path, "Control") {
    val Label = NodeRef<Label>("$path/Label", "Label")
    val Marker = NodeRef<TextureRect>("$path/Marker", "TextureRect")
}

open class NodeRef<T : Node>(
    private val path: String,
    private val type: String,
) {
    operator fun getValue(thisRef: Node, property: KProperty<*>): T {
        val node = thisRef.getNode(NodePath(path)) ?: throw NodeNotFoundException(path)
        @Suppress("UNCHECKED_CAST")
        (node as? T) ?: throw NodeInvalidTypeException(type)
        return node
    }
}

class NodeNotFoundException(expectedPath: String) : Exception("Node not found under given path $expectedPath")

class NodeInvalidTypeException(expectedType: String?) : Exception("Node is not an instance of $expectedType")
